CREATE TABLE Device (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    deviceId TEXT NOT NULL,
    lamport INTEGER NOT NULL DEFAULT 0,
    alias TEXT NOT NULL DEFAULT ''
);

getDevice:
SELECT * FROM Device WHERE id = 1;

insertDevice:
INSERT INTO Device(id, deviceId, lamport) VALUES(1, ?, 0);

setLamport:
UPDATE Device SET lamport = :lamport WHERE id = 1;

setAlias:
UPDATE Device SET alias = :alias WHERE id = 1;
