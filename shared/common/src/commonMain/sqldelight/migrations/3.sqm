ALTER TABLE Transactions ADD COLUMN syncId TEXT NOT NULL DEFAULT '';
ALTER TABLE Transactions ADD COLUMN version INTEGER NOT NULL DEFAULT 0;
ALTER TABLE Transactions ADD COLUMN originId TEXT NOT NULL DEFAULT '';
ALTER TABLE Transactions ADD COLUMN isDeleted INTEGER NOT NULL DEFAULT 0;

UPDATE Transactions SET syncId = lower(hex(randomblob(16)));

CREATE UNIQUE INDEX idx_transactions_sync_id ON Transactions(syncId);

CREATE TABLE Device (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    deviceId TEXT NOT NULL,
    lamport INTEGER NOT NULL DEFAULT 0,
    alias TEXT NOT NULL DEFAULT ''
);

CREATE TABLE Pairing (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    secret TEXT NOT NULL,
    peerDeviceId TEXT,
    peerAlias TEXT NOT NULL DEFAULT '',
    peerFingerprint TEXT NOT NULL DEFAULT ''
);
